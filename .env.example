# URL base de la aplicación bajo prueba (sin barra final obligatoria)
BASE_URL=http://localhost:3000

# Navegador objetivo: chromium | firefox | webkit
BROWSER=firefox

# Ejecución sin interfaz gráfica: true | false
HEADLESS=true

# Retardo opcional en milisegundos entre acciones de Playwright (útil para depuración local)
SLOW_MO_MS=0

# Timeouts globales en milisegundos
DEFAULT_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=30000

# Evidencias ante fallos
TRACE_ON_FAILURE=true
SCREENSHOT_ON_FAILURE=true

# Dimensiones del viewport
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900

